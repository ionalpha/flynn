# Copy to .env (in the deploy/ directory) and fill in. Never commit the real .env.

# Model provider key. Required once a channel is configured so the agent can run goals.
ANTHROPIC_API_KEY=

# Telegram bot token (optional). Set it to have the agent answer Telegram messages.
TELEGRAM_BOT_TOKEN=

# Telegram user ids allowed to start a run, comma separated, numeric (a username can be
# renamed or reassigned, so it is refused). Required when the token is set: serve will not
# start a channel that answers anyone.
FLYNN_TELEGRAM_ALLOW=

# Control-plane API bearer token (optional). If left blank, Flynn generates one and
# prints it to the logs on startup. Set it to a long random value for a stable token.
FLYNN_API_TOKEN=

# Vault passphrase (optional). Unseals the sealed credential vault non-interactively so
# configured integrations work without a TTY prompt. Required only once you store an
# integration credential. Set a long random value and keep it stable, losing it makes
# stored credentials unrecoverable.
FLYNN_VAULT_PASSPHRASE=

# Version stamped into the image at build time (optional).
FLYNN_VERSION=0.0.0-dev
