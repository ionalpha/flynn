{
  "suite_version": "0.1.0-draft",
  "tier": "L1",
  "vectors": [
    {
      "id": "valid.minimal.01",
      "expect": "accept",
      "flags": [
        "Structural"
      ],
      "description": "A single minimal event with the required fields and an empty payload.",
      "events": [
        "valid/valid_minimal_01.cbor"
      ]
    },
    {
      "id": "valid.optional_fields.01",
      "expect": "accept",
      "flags": [
        "Structural"
      ],
      "description": "A single event carrying every optional field and a payload of mixed value types.",
      "events": [
        "valid/valid_optional_fields_01.cbor"
      ]
    },
    {
      "id": "valid.chain.01",
      "expect": "accept",
      "flags": [
        "Structural",
        "Ordering"
      ],
      "description": "Three events on one stream with strictly increasing Seq.",
      "events": [
        "valid/valid_chain_01_0.cbor",
        "valid/valid_chain_01_1.cbor",
        "valid/valid_chain_01_2.cbor"
      ]
    },
    {
      "id": "invalid.enc.trailing_bytes.01",
      "expect": "reject",
      "failure_code": "enc.trailing_bytes",
      "flags": [
        "Encoding"
      ],
      "description": "A canonical event followed by one extra trailing byte.",
      "events": [
        "invalid/invalid_enc_trailing_bytes_01.cbor"
      ]
    },
    {
      "id": "invalid.enc.duplicate_map_key.01",
      "expect": "reject",
      "failure_code": "enc.duplicate_map_key",
      "flags": [
        "Encoding"
      ],
      "description": "A CBOR map containing a duplicated key.",
      "events": [
        "invalid/invalid_enc_duplicate_map_key_01.cbor"
      ]
    },
    {
      "id": "invalid.enc.indefinite_length.01",
      "expect": "reject",
      "failure_code": "enc.indefinite_length",
      "flags": [
        "Encoding"
      ],
      "description": "An indefinite-length CBOR map.",
      "events": [
        "invalid/invalid_enc_indefinite_length_01.cbor"
      ]
    },
    {
      "id": "invalid.enc.invalid_utf8.01",
      "expect": "reject",
      "failure_code": "enc.invalid_utf8",
      "flags": [
        "Encoding"
      ],
      "description": "A CBOR text string containing invalid UTF-8.",
      "events": [
        "invalid/invalid_enc_invalid_utf8_01.cbor"
      ]
    },
    {
      "id": "invalid.enc.non_canonical_cbor.01",
      "expect": "reject",
      "failure_code": "enc.non_canonical_cbor",
      "flags": [
        "Encoding"
      ],
      "description": "A valid event whose map keys are not in canonical sorted order.",
      "events": [
        "invalid/invalid_enc_non_canonical_cbor_01.cbor"
      ]
    },
    {
      "id": "invalid.chain.non_monotonic_seq.01",
      "expect": "reject",
      "failure_code": "chain.non_monotonic_seq",
      "flags": [
        "Ordering"
      ],
      "description": "Two events on one stream with a repeated Seq.",
      "events": [
        "invalid/invalid_chain_non_monotonic_seq_01_0.cbor",
        "invalid/invalid_chain_non_monotonic_seq_01_1.cbor"
      ]
    },
    {
      "id": "invalid.chain.stream_mismatch.01",
      "expect": "reject",
      "failure_code": "chain.stream_mismatch",
      "flags": [
        "Ordering"
      ],
      "description": "Two events that belong to different streams.",
      "events": [
        "invalid/invalid_chain_stream_mismatch_01_0.cbor",
        "invalid/invalid_chain_stream_mismatch_01_1.cbor"
      ]
    },
    {
      "id": "invalid.chain.empty.01",
      "expect": "reject",
      "failure_code": "chain.empty",
      "flags": [
        "Structural"
      ],
      "description": "An empty event stream.",
      "events": []
    },
    {
      "id": "valid.seq_gap.01",
      "expect": "accept",
      "flags": [
        "Structural",
        "Ordering"
      ],
      "description": "Three events with seq 1, 5, 900: a record may carry a window of a longer stream, so gaps are permitted; only repeats and decreases are rejected.",
      "events": [
        "valid/valid_seq_gap_01_0.cbor",
        "valid/valid_seq_gap_01_1.cbor",
        "valid/valid_seq_gap_01_2.cbor"
      ]
    },
    {
      "id": "valid.large_ints.01",
      "expect": "accept",
      "flags": [
        "Structural",
        "Encoding"
      ],
      "description": "Events whose seq and time exceed 2^53 (2^53+1 and the int64 maximum): a verifier that coerces int64 to a 53-bit float changes these values and fails.",
      "events": [
        "valid/valid_large_ints_01_0.cbor",
        "valid/valid_large_ints_01_1.cbor"
      ]
    },
    {
      "id": "valid.unicode_payload.01",
      "expect": "accept",
      "flags": [
        "Structural",
        "Encoding"
      ],
      "description": "A payload whose keys span one to four UTF-8 bytes, pinning bytewise-encoded key sort order and non-ASCII content.",
      "events": [
        "valid/valid_unicode_payload_01.cbor"
      ]
    },
    {
      "id": "valid.payload_bytes.01",
      "expect": "accept",
      "flags": [
        "Structural",
        "Encoding"
      ],
      "description": "A payload carrying a CBOR byte string value: binary data is a bstr, exempt from the UTF-8 rule that governs text strings.",
      "events": [
        "valid/valid_payload_bytes_01.cbor"
      ]
    },
    {
      "id": "valid.empty_strings.01",
      "expect": "accept",
      "flags": [
        "Structural",
        "Encoding"
      ],
      "description": "An event whose required string fields are empty: required fields are encoded even when empty (SPEC 2.1/8.2), as zero-length text strings.",
      "events": [
        "valid/valid_empty_strings_01.cbor"
      ]
    },
    {
      "id": "invalid.schema.missing_field.01",
      "expect": "reject",
      "failure_code": "enc.non_canonical_cbor",
      "flags": [
        "Schema"
      ],
      "description": "A canonically encoded envelope missing the required time field: the canonical re-encoding of what it decodes to differs, so it is not the canonical form of any event.",
      "events": [
        "invalid/invalid_schema_missing_field_01.cbor"
      ]
    },
    {
      "id": "invalid.schema.unknown_field.01",
      "expect": "reject",
      "failure_code": "enc.non_canonical_cbor",
      "flags": [
        "Schema"
      ],
      "description": "A canonically encoded envelope carrying an unknown extra field, which no canonical event encoding contains.",
      "events": [
        "invalid/invalid_schema_unknown_field_01.cbor"
      ]
    },
    {
      "id": "invalid.schema.wrong_type.01",
      "expect": "reject",
      "failure_code": "enc.decode",
      "flags": [
        "Schema"
      ],
      "description": "An envelope whose seq is a text string rather than an integer.",
      "events": [
        "invalid/invalid_schema_wrong_type_01.cbor"
      ]
    },
    {
      "id": "invalid.schema.bad_actor.01",
      "expect": "reject",
      "failure_code": "enc.invalid_actor",
      "flags": [
        "Schema"
      ],
      "description": "An envelope whose actor is not one of the closed category agent, human, or system.",
      "events": [
        "invalid/invalid_schema_bad_actor_01.cbor"
      ]
    },
    {
      "id": "invalid.enc.non_minimal_int.01",
      "expect": "reject",
      "failure_code": "enc.non_canonical_cbor",
      "flags": [
        "Encoding"
      ],
      "description": "A full envelope whose seq value 1 is encoded in a two-byte integer head: same value, not the shortest encoding.",
      "events": [
        "invalid/invalid_enc_non_minimal_int_01.cbor"
      ]
    },
    {
      "id": "invalid.enc.duplicate_map_key_full.01",
      "expect": "reject",
      "failure_code": "enc.duplicate_map_key",
      "flags": [
        "Encoding"
      ],
      "description": "A full envelope grown by a duplicated seq entry, so duplicate-key rejection is pinned on a complete event, not only a fragment.",
      "events": [
        "invalid/invalid_enc_duplicate_map_key_full_01.cbor"
      ]
    },
    {
      "id": "invalid.enc.indefinite_length_full.01",
      "expect": "reject",
      "failure_code": "enc.indefinite_length",
      "flags": [
        "Encoding"
      ],
      "description": "A full envelope framed as an indefinite-length map.",
      "events": [
        "invalid/invalid_enc_indefinite_length_full_01.cbor"
      ]
    }
  ]
}
