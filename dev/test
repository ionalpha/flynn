#!/usr/bin/env sh
# Run the test suite with the race detector and coverage.
# Identical invocation to CI, so a green run here means a green run there.
# With no args, tests everything; pass args to scope, e.g. `dev/test ./state/...`.
#
# The race detector always runs: it is the point of this gate. Coverage
# instrumentation is separable via COVER, which defaults to atomic coverage
# written to coverage.out (the local and primary-CI invocation). Set COVER= to
# run without it: CI uploads coverage from one platform only, so the other
# platforms skip the instrumentation cost while still running every test under
# -race.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
: "${COVER=-covermode=atomic -coverprofile=coverage.out}"
# Randomize test order within each package. A suite that only passes in a fixed
# order (shared package-level state, an init-order dependency) fails here rather
# than mysteriously later or on another machine. Go prints the chosen seed as
# "-test.shuffle <seed>"; replay an exact order with SHUFFLE=<seed>. Off by
# default nowhere: it costs no extra run, so it is always on.
: "${SHUFFLE=on}"
# COUNT re-runs each test N times in the same process, surfacing state that
# leaks between repetitions and non-deterministic (flaky) tests. Unset by
# default (a single, cache-eligible run); set COUNT=2 to double-run. CI scopes
# a COUNT=2 pass to a subset rather than paying it on the whole -race suite.
count=${COUNT:+-count=$COUNT}
if [ "$#" -eq 0 ]; then set -- ./...; fi
# shellcheck disable=SC2086  # COVER and count are intentionally split into flags.
echo "==> go test -race -shuffle=$SHUFFLE $count $COVER $*"
go test -race -shuffle="$SHUFFLE" $count $COVER "$@"
