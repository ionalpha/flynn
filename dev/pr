#!/usr/bin/env sh
# Open a pull request against main, using the repo's PR template.
# Thin wrapper around `gh pr create` so the base branch and template are
# consistent for everyone. A scripted body must contain the template's sections
# (## What / ## Why / ## How to verify) or this refuses - the template can't be
# skipped by passing --body. Any extra args pass straight through to gh, e.g.:
#   dev/pr                                  # interactive, opens the template
#   dev/pr --title "feat: x" --body-file b  # scripted
#   dev/pr --ready                          # skip the draft, run the full suite now
#   dev/pr --web                            # finish in the browser
#
# A pull request opens as a draft. CI runs its fast tier on a draft (build, lint,
# unit tests on one platform, secret scan) and the full cross-platform suite once
# the pull request is marked ready, so review and revision happen before the
# expensive jobs run, and they run once on the code that is actually proposed.
# Pass --ready to open a pull request that is ready for review immediately.
#
# Requires the GitHub CLI: https://cli.github.com
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

command -v gh >/dev/null 2>&1 || { echo "GitHub CLI (gh) not found: https://cli.github.com" >&2; exit 1; }

branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ]; then
  echo "Refusing to open a PR from 'main'. Create a feature branch first:" >&2
  echo "  git switch -c feat/my-change" >&2
  exit 1
fi

# Enforce the PR template. gh only opens the template when no body is passed, so a
# scripted --body/--body-file silently bypasses it. Instead of trusting that, we
# require any explicit body to carry the template's sections - the template becomes
# impossible to skip, not merely the default. Interactive runs (no body flag) fall
# through to gh, which opens .github/PULL_REQUEST_TEMPLATE.md as usual.
template=".github/PULL_REQUEST_TEMPLATE.md"

# An argument that follows one of these is that option's value, whatever it spells.
# Both loops below consult this, and both forget it the moment they consume a value:
# a value is never an option, so `--title --body` gives a pull request titled
# "--body" and leaves the next argument to be read on its own terms. Confusing the
# two lets `dev/pr --body "$body" --title --body --ready` read "--ready" as the body,
# refusing a pull request whose body was there all along.
is_value_opt() {
  case "$1" in
    --title|-t|--body|-b|--body-file|-F|--base|-B|--head|-H|--assignee|-a|\
--label|-l|--milestone|-m|--project|-p|--reviewer|-r) return 0 ;;
  esac
  return 1
}

# Enforce the PR template. gh only opens the template when no body is passed, so a
# scripted --body/--body-file silently bypasses it. Instead of trusting that, we
# require any explicit body to carry the template's sections - the template becomes
# impossible to skip, not merely the default. Interactive runs (no body flag) fall
# through to gh, which opens .github/PULL_REQUEST_TEMPLATE.md as usual.
body=""; have_body=0; prev=""
for arg in "$@"; do
  if is_value_opt "$prev"; then
    case "$prev" in
      --body|-b)      body="$arg"; have_body=1 ;;
      --body-file|-F) body="$(cat -- "$arg")"; have_body=1 ;;
    esac
    prev=""
    continue
  fi
  case "$arg" in
    --body=*)       body="${arg#--body=}"; have_body=1 ;;
    --body-file=*)  body="$(cat -- "${arg#--body-file=}")"; have_body=1 ;;
  esac
  prev="$arg"
done
if [ "$have_body" -eq 1 ]; then
  for section in '## What' '## Why' '## How to verify'; do
    case "$body" in
      *"$section"*) ;;
      *)
        echo "Refusing to open a PR: the body is missing the '$section' section." >&2
        echo "Base it on $template (What / Why / How to verify / Notes)." >&2
        exit 1 ;;
    esac
  done

  # A pull request body is not a commit message. GitHub renders a newline inside
  # a paragraph as a line break, so prose wrapped at 72 columns displays as a
  # column of ragged short lines. One line per paragraph is the only form whose
  # rendering matches what was written.
  #
  # This is duplicated in .github/workflows/pr-body.yml rather than shared, the
  # same way the section list above is. That workflow deliberately checks nothing
  # out: on a fork's pull request a checkout would take the fork's copy of this
  # script, and a gate the contributor can edit is not a gate.
  if ! printf '%s\n' "$body" | awk '
    { sub(/\r$/, "") }
    /^[ \t]*(```|~~~)/ { fence = !fence; prev = ""; next }
    fence { next }
    /^[ \t]*$/ { prev = ""; next }
    {
      block = ($0 ~ /^[ \t]*([-*+>|#=]|[0-9]+[.)]|<)/)
      if (prev != "" && !block) {
        printf "  line %d continues the line above: \"%s\"\n", NR, substr($0, 1, 60) > "/dev/stderr"
        bad++
      }
      prev = block ? "" : $0
    }
    END { exit (bad > 0) }
  '; then
    echo "Refusing to open a PR: the body has hard-wrapped paragraphs." >&2
    echo "GitHub renders those newlines as line breaks. Put each paragraph on one line;" >&2
    echo "lists, tables and fenced code are unaffected." >&2
    exit 1
  fi
fi

# --ready is ours, not gh's: drop it and open a pull request that is ready for review.
# Otherwise the pull request opens as a draft, unless the caller already said --draft.
#
# The arguments are rotated through the positional parameters rather than collected
# into a string. A PR body is multi-line and contains quotes; re-splitting it through
# a variable or eval truncates it at the first newline.
draft="--draft"
n=$#
i=0
prev=""
while [ "$i" -lt "$n" ]; do
  arg="$1"
  shift
  i=$((i + 1))
  # An argument that follows an option taking a value IS that value, whatever it
  # spells. `dev/pr --body --ready` asks for a pull request whose body is the text
  # "--ready", and eating it would run gh with a --body that has no value.
  if is_value_opt "$prev"; then
    set -- "$@" "$arg"
    prev=""
    continue
  fi
  case "$arg" in
    --ready) draft="" ; prev="$arg" ; continue ;;  # ours, never passed to gh
    --draft) draft="" ;;                           # the caller said it; do not say it twice
  esac
  set -- "$@" "$arg"
  prev="$arg"
done

# gh auto-detects the PR template; --fill-first seeds title from the first commit
# when the caller doesn't pass one. Push happens via gh if there's no upstream.
# shellcheck disable=SC2086 # $draft is one word or empty, and must vanish when empty.
exec gh pr create --base main $draft "$@"
