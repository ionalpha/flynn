#!/usr/bin/env sh
# Check what our SKILL.md writer emits against the format's own reference validator.
# Mirrors CI.
#
# Every other test in skill/skillmd checks our reader against our writer, which
# proves they agree with each other and nothing about the specification. skills-ref
# is the reference library for Agent Skills, so this is the check that catches us
# being self-consistently wrong. Needs Node (npx ships with it).
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# dev/skills-ref holds the version and a lockfile with an integrity hash for every
# package in the tree, so local and CI install the same bytes and a republished
# version fails the install instead of running.
LOCKDIR="dev/skills-ref"

if ! command -v npm >/dev/null 2>&1; then
  echo "npm not found. Install Node.js to run the reference validator." >&2
  exit 1
fi

# Install into a scratch prefix rather than the repository: this is a check, not a
# dependency, and nothing in the Go module should gain a node_modules beside it. The
# prefix is keyed by the lockfile's hash so a changed pin never reuses an old install.
LOCKSUM=$(cksum <"$LOCKDIR/package-lock.json" | cut -d' ' -f1)
PREFIX="${TMPDIR:-/tmp}/flynn-skills-ref-$LOCKSUM"
if [ ! -x "$PREFIX/node_modules/.bin/skills-ref" ]; then
  echo "==> installing skills-ref from $LOCKDIR/package-lock.json"
  mkdir -p "$PREFIX"
  cp "$LOCKDIR/package.json" "$LOCKDIR/package-lock.json" "$PREFIX/"
  npm ci --silent --ignore-scripts --prefix "$PREFIX" >/dev/null
fi

PATH="$PREFIX/node_modules/.bin:$PATH"
export PATH
# Set so the test fails rather than skips if the binary is somehow still missing: a
# conformance check that silently skips is a green tick that proves nothing.
FLYNN_REQUIRE_SKILLS_REF=1
export FLYNN_REQUIRE_SKILLS_REF

echo "==> skills-ref validate (over what skillmd.Write produces)"
go test ./skill/skillmd/ -run TestReferenceValidatorAcceptsWhatWeWrite -count=1 -v
