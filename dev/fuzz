#!/usr/bin/env sh
# The hostile-input gate: run every fuzz target with live mutation for a
# short budget, so a new crasher fails the build instead of waiting for
# someone to fuzz by hand. The committed seed corpus already replays under
# dev/test; this adds mutation on top of it.
#
# `go test -fuzz` accepts exactly one target in one package per invocation,
# so this enumerates every FuzzXxx function and runs each in turn.
#
# FUZZTIME sets the per-target budget (default 5s; the nightly workflow
# raises it). With no args, covers every package that declares a fuzz
# target; pass directories to scope, e.g. `dev/fuzz ./state`.
#
# FUZZ_SHARD=<k>/<n>, if set, runs only the kth of n slices of the target
# list, so n jobs can cover every target in parallel. The nightly uses this:
# its budget is per target, so one job pays the sum of every target's budget
# while n jobs pay the slowest slice.
#
# FUZZ_BASE=<git ref>, if set, scopes the run to targets that the diff since
# the merge-base with that ref can affect: packages whose own directory
# changed (including seed corpora) or whose test import graph reaches a
# package with changed Go files. Build or workflow config changes fall back
# to the full sweep. CI sets this to the PR base so a PR only pays for the
# targets it can break; pushes to main and the nightly keep the full sweep.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
: "${FUZZTIME=5s}"
if [ "$#" -eq 0 ]; then set -- .; fi

# New (untracked) inputs under a package's testdata/fuzz/<target>/ are where
# `go test -fuzz` writes a failing input, and nowhere else. Writing one is a
# necessary but not a sufficient sign of a crasher: see fuzz_one.
new_inputs() {
	git ls-files --others --exclude-standard -- "$1/testdata/fuzz/$2" 2>/dev/null
}

# Replay every input in a target's corpus, the committed seeds plus whatever
# the last run wrote. A real crasher reproduces here; a phantom does not.
replays_clean() {
	go test -count=1 -run="^${2}\$" "./${1#./}"
}

# Run one target under mutation and decide whether a failure is real.
#
# A failed run is only a crasher if the input it wrote reproduces on replay.
# Two things fail a run without finding anything: the toolchain's shutdown
# race at budget expiry (the golang/go#56238 family), which writes no input,
# and a worker the OS kills mid-run, which does leave its last input behind.
# Trusting the file alone turns a killed worker into a build failure over an
# input that was never a crasher. Replaying it separates the two.
fuzz_one() {
	dir=$1
	target=$2
	echo "==> go test -fuzz=^${target}\$ -fuzztime=$FUZZTIME $dir"
	if go test -run='^$' -fuzz="^${target}\$" -fuzztime="$FUZZTIME" "./${dir#./}"; then
		return 0
	fi
	if [ -n "$(new_inputs "$dir" "$target")" ]; then
		echo "==> replaying the input $target wrote, to confirm it reproduces"
		if ! replays_clean "$dir" "$target"; then
			echo "dev/fuzz: $target found a crasher; failing input is under $dir/testdata/fuzz/$target/" >&2
			return 1
		fi
		echo "==> $target: the input passes on replay; discarding it, the run died without a finding"
		new_inputs "$dir" "$target" | while read -r input; do rm -f "$input"; done
	fi
	# No reproducing input. One retry separates a dead run from a
	# deterministic failure: the first passes on a second try, the second
	# does not.
	echo "==> retrying $target: the first run failed without a reproducing input"
	if go test -run='^$' -fuzz="^${target}\$" -fuzztime="$FUZZTIME" "./${dir#./}"; then
		return 0
	fi
	if [ -n "$(new_inputs "$dir" "$target")" ] && ! replays_clean "$dir" "$target"; then
		echo "dev/fuzz: $target found a crasher; failing input is under $dir/testdata/fuzz/$target/" >&2
	else
		echo "dev/fuzz: $target failed twice without a reproducing input; not a mutation crasher, inspect the output above" >&2
	fi
	return 1
}

dirs=$(grep -rl '^func Fuzz' --include='*_test.go' "$@" | xargs -n1 dirname | sort -u)

if [ -n "${FUZZ_BASE:-}" ]; then
	if ! base=$(git merge-base "$FUZZ_BASE" HEAD 2>/dev/null); then
		echo "dev/fuzz: cannot resolve FUZZ_BASE=$FUZZ_BASE; running the full sweep" >&2
	else
		changed=$(git diff --name-only "$base" HEAD)
		if printf '%s\n' "$changed" | grep -qE '^(go\.mod|go\.sum|dev/fuzz|\.github/workflows/)'; then
			echo "dev/fuzz: build or workflow config changed since $base; running the full sweep"
		else
			module=$(go list -m)
			changedpkgs=$(printf '%s\n' "$changed" | grep '\.go$' | xargs -r -n1 dirname |
				sort -u | awk -v m="$module" '{ print $0 == "." ? m : m "/" $0 }')
			scoped=''
			for dir in $dirs; do
				rel=${dir#./}
				# A change inside the package itself (seed corpus included)
				# always counts; otherwise walk the test import graph. The
				# module root owns only its own testdata; its Go files are
				# covered by the import-graph check like any other package.
				case $rel in .) prefix='testdata/' ;; *) prefix="$rel/" ;; esac
				if printf '%s\n' "$changed" | grep -q "^$prefix"; then
					scoped="$scoped $dir"
					continue
				fi
				# Test variants print as "path [pkg.test]"; keep the path.
				deps=$(go list -deps -test "./$rel" | awk '{ print $1 }')
				for pkg in $changedpkgs; do
					if printf '%s\n' "$deps" | grep -qxF "$pkg"; then
						scoped="$scoped $dir"
						break
					fi
				done
			done
			dirs=$scoped
			if [ -z "$dirs" ]; then
				echo "dev/fuzz: no fuzz target is affected by the diff since $base; nothing to run"
				exit 0
			fi
		fi
	fi
fi

# One line per target, "<dir>:<target>". Neither half can contain a space, so
# the list survives ordinary word splitting.
targets=''
for dir in $dirs; do
	for target in $(grep -h '^func Fuzz' "$dir"/*_test.go | sed -E 's/^func (Fuzz[A-Za-z0-9_]+).*/\1/' | sort -u); do
		targets="$targets$dir:$target
"
	done
done

if [ -n "${FUZZ_SHARD:-}" ]; then
	k=${FUZZ_SHARD%%/*}
	n=${FUZZ_SHARD##*/}
	if ! printf '%s' "$FUZZ_SHARD" | grep -qE '^[1-9][0-9]*/[1-9][0-9]*$' || [ "$k" -gt "$n" ]; then
		echo "dev/fuzz: FUZZ_SHARD must be <k>/<n> with 1 <= k <= n; got $FUZZ_SHARD" >&2
		exit 2
	fi
	count() { printf '%s' "$1" | awk 'NF { c++ } END { print c + 0 }'; }
	total=$(count "$targets")
	# Deal the targets out round-robin rather than in contiguous blocks: a
	# package's targets sit next to each other in this list and tend to cost
	# alike, so blocks would pile the slow ones into one shard.
	targets=$(printf '%s' "$targets" | awk -v k="$k" -v n="$n" 'NR % n == k % n')
	echo "dev/fuzz: shard $k of $n: $(count "$targets") of $total targets"
fi

fail=0
for pair in $targets; do
	fuzz_one "${pair%%:*}" "${pair##*:}" || fail=1
done

if [ "$fail" -ne 0 ]; then
	echo "dev/fuzz: failures above; commit any new input under */testdata/fuzz/ together with the fix" >&2
fi
exit "$fail"
