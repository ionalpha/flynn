#!/usr/bin/env sh
# The test-quality gate: mutate production code (flip operators, delete
# statements, invert conditions) and require the suite to catch each change.
# A test that runs the code but asserts nothing passes dev/test and coverage
# yet kills no mutant, so this is the check that a test actually BITES. It
# complements the rigor gate, which proves a test EXISTS, by proving it works.
#
# Runs gremlins (github.com/go-gremlins/gremlins), pinned to the version below
# so a local run matches CI. With no args it mutates the whole module; pass
# directories to scope, e.g. `dev/mutate ./dispatch`.
#
# MUTATE_BASE=<git ref>, if set, scopes the run to lines changed since that ref
# using gremlins' own --diff mode. CI sets it to the PR base so a PR only pays
# for the lines it touches. Scoping is what keeps this usable: every mutant
# recompiles and reruns the affected tests, so a full-module run is minutes to
# tens of minutes.
#
# Note: gremlins' coverage step is broken on native Windows (it mishandles the
# package path). Run this on Linux or under WSL; CI runs it on ubuntu.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# Keep in sync with the install pin in .github/workflows/ci.yml.
GREMLINS_VERSION="v0.6.0"

gremlins="$(command -v gremlins || true)"
if [ -z "$gremlins" ]; then
	gobin="$(go env GOBIN)"; [ -n "$gobin" ] || gobin="$(go env GOPATH)/bin"
	if [ -x "$gobin/gremlins" ]; then
		gremlins="$gobin/gremlins"
	else
		echo "gremlins not found. Install the version CI uses:" >&2
		echo "  go install github.com/go-gremlins/gremlins/cmd/gremlins@$GREMLINS_VERSION" >&2
		exit 1
	fi
fi

# Thresholds live in .gremlins.yaml (currently advisory: 0, so this reports
# surviving mutants without failing). A nonzero exit means an armed threshold
# was missed, or gremlins itself errored.
set -- unleash "$@"
if [ -n "${MUTATE_BASE:-}" ]; then
	if base=$(git merge-base "$MUTATE_BASE" HEAD 2>/dev/null); then
		# --diff restricts mutation to lines changed since base. A change that
		# touches no production Go line has nothing to mutate, and mutating the
		# whole module to say so costs a quarter of an hour, so say so and stop.
		# The module still gets a full run on every push to main.
		if [ -z "$(git diff --name-only "$base" HEAD -- '*.go' ':!*_test.go')" ]; then
			echo "dev/mutate: no production Go line changed since $base; nothing to mutate"
			exit 0
		fi
		echo "dev/mutate: scoping to lines changed since $base"
		set -- "$@" --diff "$base"
	else
		echo "dev/mutate: cannot resolve MUTATE_BASE=$MUTATE_BASE; mutating the full module" >&2
	fi
fi

echo "==> gremlins $*"
exec "$gremlins" "$@"
