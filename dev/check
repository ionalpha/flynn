#!/usr/bin/env sh
# The full pre-flight: everything CI gates on, in one command.
# A green `dev/check` locally means a green CI run. Run this before opening a PR.
#
# Steps mirror .github/workflows/ci.yml (which calls these same scripts):
#   build -> vet -> test (race+coverage) -> coverfloor -> lint (mod tidy +
#     golangci-lint) -> vuln -> secrets (gitleaks) -> osv (osv-scanner)
set -eu
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
cd "$here/.."

# Activate the repo's git hooks (idempotent). Running the documented pre-flight
# once is enough to arm the pre-commit secret gate in .githooks/.
git config core.hooksPath .githooks

"$here/build"

echo "==> go vet ./..."
go vet ./...

"$here/test"
"$here/coverfloor"
"$here/lint"
"$here/vuln"
"$here/secrets"
"$here/osv"

echo
echo "OK: all checks passed."
