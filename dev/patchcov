#!/usr/bin/env sh
# Report coverage of the lines THIS BRANCH CHANGED, which is the number the pull
# request is judged on and the one no local gate could see.
#
# dev/coverfloor guards the whole tree: it catches a change that lowers overall
# coverage. It cannot catch a change that ADDS a hundred untested lines to a
# well-tested tree, because the total barely moves. That is the gap this closes,
# and it is the one that keeps failing on the pull request rather than here.
#
#   ./dev/test && ./dev/patchcov
#
# Coverage is measured per statement, on the statements whose lines the diff
# touched. A change that only deletes code, or only touches comments and test
# files, has nothing to measure and passes.
#
# BASE is what the branch is compared against (default origin/main). MIN is the
# percentage below which this fails (default 80, matching the pull request gate).
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

profile="${COVERAGE_PROFILE:-coverage.out}"
base="${BASE:-origin/main}"
min="${MIN:-80}"

if [ ! -f "$profile" ]; then
  echo "==> no $profile: run ./dev/test first" >&2
  exit 1
fi

merge_base="$(git merge-base "$base" HEAD 2>/dev/null || true)"
if [ -z "$merge_base" ]; then
  echo "==> cannot find a merge base with $base: fetch it first, or set BASE" >&2
  exit 1
fi

# The diff, with no context lines, so only lines the change actually touched are
# listed. Test files are excluded: a test is not the thing under test, and
# counting it would let a change cover itself.
git diff -U0 "$merge_base"...HEAD -- '*.go' ':(exclude)*_test.go' >/tmp/patchcov.diff

awk -v min="$min" '
# Pass 1: the changed lines, from the diff.
FILENAME ~ /patchcov.diff$/ {
  if ($0 ~ /^\+\+\+ b\//) { file = substr($0, 7); next }
  if ($0 ~ /^@@/ && file != "") {
    # @@ -old,n +new,m @@ : take the new-side start and count.
    match($0, /\+[0-9]+(,[0-9]+)?/)
    spec = substr($0, RSTART + 1, RLENGTH - 1)
    split(spec, a, ",")
    start = a[1] + 0
    count = (a[2] == "" ? 1 : a[2] + 0)
    for (i = 0; i < count; i++) changed[file ":" (start + i)] = 1
  }
  next
}

# Pass 2: the coverage profile. Each block is "pkg/path.go:sl.sc,el.ec stmts count".
/^mode:/ { next }
{
  n = split($1, loc, ":")
  path = loc[1]
  for (i = 2; i < n; i++) path = path ":" loc[i]   # a path may contain a colon
  sub(/^github\.com\/ionalpha\/flynn\//, "", path)

  split(loc[n], range, ",")
  split(range[1], from, ".")
  split(range[2], to, ".")
  sl = from[1] + 0
  el = to[1] + 0
  stmts = $2 + 0
  count = $3 + 0

  # A block counts if the diff touched any line of it.
  for (line = sl; line <= el; line++) {
    if ((path ":" line) in changed) {
      total += stmts
      if (count > 0) hit += stmts
      else {
        missing[path] = missing[path] " " sl "-" el
        miss[path] += stmts
      }
      break
    }
  }
}

END {
  if (total == 0) {
    print "==> no changed statements to measure (deletions, comments or tests only)"
    exit 0
  }
  pct = 100 * hit / total
  for (f in miss) printf "    %s: %d uncovered statement(s) at%s\n", f, miss[f], missing[f]
  printf "==> patch coverage %.1f%% (%d/%d changed statements)\n", pct, hit, total
  if (pct < min + 0) {
    printf "    Below %s%%. These are lines this branch ADDED and nothing runs.\n", min
    printf "    The tree-wide floor will not catch this: a hundred untested new lines\n"
    printf "    barely move a total measured over the whole repository.\n"
    exit 1
  }
}
' /tmp/patchcov.diff "$profile"
