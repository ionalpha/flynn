#!/usr/bin/env sh
# Scan the repository history for committed secrets. Mirrors CI.
# Installs gitleaks on demand if it is not already available.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# Pin the version so local and CI results match. go install verifies the module
# against the Go checksum database, so the install is reproducible and tamper-evident.
GITLEAKS_VERSION="v8.30.1"

gitleaks="$(command -v gitleaks || true)"
if [ -z "$gitleaks" ]; then
  gobin="$(go env GOBIN)"; [ -n "$gobin" ] || gobin="$(go env GOPATH)/bin"
  if [ -x "$gobin/gitleaks" ]; then
    gitleaks="$gobin/gitleaks"
  else
    echo "==> installing gitleaks $GITLEAKS_VERSION"
    go install github.com/zricethezav/gitleaks/v8@"$GITLEAKS_VERSION"
    gitleaks="$gobin/gitleaks"
  fi
fi

# Scan the whole commit history, not just the working tree: a secret added and
# later deleted still lives in the history and is what an attacker reads.
echo "==> gitleaks git (full history)"
"$gitleaks" git .
