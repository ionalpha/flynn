#!/usr/bin/env sh
# Prove a published release is reachable by `flynn upgrade` from an earlier one.
#
#   dev/upgrade-check <tag> [from]     e.g. dev/upgrade-check v0.2.0-rc.1 v0.1.3
#
# Everyone already installed reaches a new release through the verifier compiled into
# the release they have, so that is the binary this runs: the published <from> release
# for this OS and architecture (default: the newest release before <tag>), checked
# against its signed checksums. It upgrades to <tag> and requires that the binary then
# reports <tag> and still opens the data directory the old one wrote. Run it after a
# release or candidate is published; .github/workflows/upgrade-check.yml does.
set -eu

tag="${1:?usage: dev/upgrade-check <tag> [from]}"
from="${2:-}"
repo="ionalpha/flynn"

case "$(uname -s)" in
  Linux*) os=linux ;;
  Darwin*) os=darwin ;;
  MINGW* | MSYS* | CYGWIN*) os=windows ;;
  *) echo "upgrade-check: unsupported OS $(uname -s)" >&2; exit 2 ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) echo "upgrade-check: unsupported architecture $(uname -m)" >&2; exit 2 ;;
esac
ext=tar.gz
bin=flynn
if [ "$os" = windows ]; then
  ext=zip
  bin=flynn.exe
fi

if [ -z "$from" ]; then
  # The newest full release that is not the one under test: the version most
  # installs will be upgrading from.
  from="$(gh release list --repo "$repo" --exclude-pre-releases --limit 20 --json tagName -q '.[].tagName' |
    grep -vx "$tag" | head -n 1)"
  [ -n "$from" ] || { echo "upgrade-check: no earlier release to upgrade from" >&2; exit 2; }
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
asset="flynn_${os}_${arch}.${ext}"
base="https://github.com/$repo/releases/download/$from"

echo "==> downloading $from $asset"
curl -fsSL -o "$work/$asset" "$base/$asset"
curl -fsSL -o "$work/checksums.txt" "$base/checksums.txt"
want="$(grep " $asset\$" "$work/checksums.txt" | cut -d' ' -f1)"
if command -v sha256sum >/dev/null 2>&1; then
  got="$(sha256sum "$work/$asset" | cut -d' ' -f1)"
else
  got="$(shasum -a 256 "$work/$asset" | cut -d' ' -f1)"
fi
[ -n "$want" ] && [ "$got" = "$want" ] || { echo "upgrade-check: $asset does not match $from's checksums" >&2; exit 1; }

mkdir "$work/bin" "$work/data"
if [ "$ext" = zip ]; then
  unzip -q "$work/$asset" -d "$work/bin"
else
  tar -xzf "$work/$asset" -C "$work/bin"
fi
flynn="$work/bin/$bin"
chmod +x "$flynn"

# Versions print without the leading v.
before="$("$flynn" --version)"
[ "$before" = "${from#v}" ] || { echo "upgrade-check: $from reports $before" >&2; exit 1; }

# A data directory the old version wrote, so the new one has to open it.
"$flynn" --data-dir "$work/data" runs >/dev/null

echo "==> $from: flynn upgrade --to $tag"
"$flynn" --data-dir "$work/data" upgrade --to "$tag" --pre --yes

after="$("$flynn" --version)"
[ "$after" = "${tag#v}" ] || { echo "upgrade-check: after the upgrade the binary reports $after, want ${tag#v}" >&2; exit 1; }
"$flynn" --data-dir "$work/data" runs >/dev/null
"$flynn" --data-dir "$work/data" runs >/dev/null

echo "ok: $from upgraded itself to $tag on $os/$arch and opened its data directory"
